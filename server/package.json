{
  "name": "@xingtu/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "verify:stage1": "tsx scripts/verify-stage1.ts",
    "verify:stage2": "tsx scripts/verify-stage2.ts",
    "password": "tsx scripts/password.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/static": "8.3.0",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cheerio": "1.1.2",
    "dotenv": "17.2.2",
    "fastify": "5.12.5",
    "node-cron": "4.2.1",
    "zod": "3.25.76",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "22.18.6",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
