DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=4010
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4173
APP_TIMEZONE=Asia/Shanghai
# 本地演示可设 true；正式运营设 false，禁用演示采集及有效比价。
DEMO_ENABLED=true
# 生产空库首次管理员初始化需至少32字符随机凭证；已有管理员不能重复初始化。
BOOTSTRAP_TOKEN="replace-with-another-random-secret-at-least-32-characters"
# 默认空：只允许公网80/443。经审核内部网关需精确 hostname:port，禁止通配符。
HTTP_ALLOWED_HOSTS=""
# 仅在受控反向代理后开启，否则不信任客户端提供的 X-Forwarded-For。
TRUST_PROXY=false
NODE_ENV=development
